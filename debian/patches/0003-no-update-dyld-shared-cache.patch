Description: Do not require the unused Darwin shared cache updater
 No PIE package ships update_dyld_shared_cache, and dpkg never runs it,
 so checkpath does not require it on Darwin.
Author: The Blueberry Pie OS Authors
Forwarded: not-needed
Last-Update: 2026-11-04

--- a/src/main/help.c
+++ b/src/main/help.c
@@ -18,6 +18,7 @@
  * You should have received a copy of the GNU General Public License
  * along with this program.  If not, see <https://www.gnu.org/licenses/>.
  */
+/* Modified 2026-10-29, 2026-10-30 and 2026-11-04: the Darwin shared cache updater is not required (GPL-2.0 section 2(a)). */
 
 #include <config.h>
 #include <compat.h>
@@ -89,7 +90,6 @@
     /* macOS uses dyld (Mach-O) instead of ld.so (ELF), and does not have
      * an ldconfig. */
 #if defined(__APPLE__) && defined(__MACH__)
-    "update_dyld_shared_cache",
 #elif defined(__GLIBC__) || defined(__UCLIBC__) || \
       defined(__FreeBSD__) || defined(__OpenBSD__) || defined(__NetBSD__)
     "ldconfig",
