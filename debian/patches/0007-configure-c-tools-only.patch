Description: Only what the C tools need is configured
 The package ships only the C tools. configure.ac does not make
 dselect's Makefiles, the Perl scripts' Makefiles, libdpkg.pc, the
 Doxyfile, the Perl module's Build.PL and README.cpan, or the test
 suite's atlocal, and does not look for curses, which only dselect
 uses. The top Makefile does not build dselect or scripts/, does not
 install m4/dpkg-unicode.m4, and does not include the CPAN recipe. So
 configure and automake do not read their templates and inputs.
Author: The Blueberry Pie OS Authors
Forwarded: not-needed
Last-Update: 2026-11-04

--- a/configure.ac
+++ b/configure.ac
@@ -1,5 +1,6 @@
 # Process this file with autoconf to produce a configure script.
 # Modified 2026-10-29, 2026-10-30 and 2026-11-04: no gettext and no translated manuals (GPL-2.0 section 2(a)).
+# Modified 2026-11-04: only what the C tools need is configured (GPL-2.0 section 2(a)).
 
 m4_pattern_forbid([^_?DPKG_])
 
@@ -113,9 +114,6 @@
 DPKG_LIB_LZMA
 DPKG_LIB_ZSTD
 DPKG_LIB_SELINUX
-AS_IF([test "$build_dselect" = "yes"], [
-  DPKG_LIB_CURSES
-])
 AS_IF([test "$build_start_stop_daemon" = "yes"], [
   DPKG_LIB_SOCKET
   DPKG_LIB_PS
@@ -250,20 +248,11 @@
 
 AC_CONFIG_FILES([
   Makefile
-  dselect/Makefile
-  dselect/methods/Makefile
   lib/Makefile
   lib/compat/Makefile
   lib/dpkg/Makefile
-  lib/dpkg/libdpkg.pc
-  doc/Doxyfile
   man/Makefile
-  scripts/Build.PL
-  scripts/Makefile
-  scripts/README.cpan
-  scripts/mk/Makefile
   src/Makefile
-  src/at/atlocal
   utils/Makefile
 ])
 AC_CONFIG_HEADERS([config.h])
