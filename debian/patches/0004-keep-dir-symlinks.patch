+/* Modified 2026-10-29 and 2026-11-04: Darwin system directory symlinks are kept on removal (GPL-2.0 section 2(a)). */
 
 #include <config.h>
 #include <compat.h>
@@ -261,6 +262,46 @@
   return shared;
 }
 
+#if defined(__APPLE__) && defined(__MACH__)
+static bool
+removal_keep_dir_symlink(const char *pathname, const char *name)
+{
+  static const char *const private_links[] = { "/etc", "/tmp", "/var", NULL };
+  const char *const *link;
+  struct stat st;
+  struct dirent *dent;
+  DIR *dir;
+  bool keep = false;
+
+  if (lstat(pathname, &st) != 0 || !S_ISLNK(st.st_mode) ||
+      stat(pathname, &st) != 0 || !S_ISDIR(st.st_mode))
+    return false;
+
+  for (link = private_links; *link; link++)
+    if (strcmp(name, *link) == 0)
+      return true;
+
+  dir = opendir(pathname);
+  if (dir == NULL)
+    return false;
+  while ((dent = readdir(dir)) != NULL) {
+    if (strcmp(dent->d_name, ".") != 0 && strcmp(dent->d_name, "..") != 0) {
+      keep = true;
+      break;
+    }
+  }
+  closedir(dir);
+
+  return keep;
+}
+#else
+static bool
+removal_keep_dir_symlink(const char *pathname, const char *name)
+{
+  return false;
+}
+#endif
